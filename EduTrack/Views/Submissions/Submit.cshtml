@*
    ================================================================================
    [دليل الطالب - Submissions/Submit.cshtml]
    - Model: SubmitAssignmentViewModel
    - Controller: SubmissionsController -> [Authorize(Roles = "Student")]
    - Action: Submit(int assignmentId) [GET] & Submit(SubmitAssignmentViewModel model) [POST]
    - خطوات الـ POST:
      1) احصل على UserId للطالب الحالي بـ _userManager.GetUserId(User) ثم ابحث عن سجل الطالب في جدول Students.
      2) تحقق من امتداد ملف SolutionFile (يسمح بـ .pdf أو .zip).
      3) احفظ الملف في wwwroot/uploads/submissions باسم فريد.
      4) أنشئ سجل Submission بحالة "Pending" واحفظه، ثم حول الطالب لصفحة MySubmissions.
    ================================================================================
*@
@model SubmitAssignmentViewModel
@{
    ViewData["Title"] = "رفع حل التاسك";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 mb-2">بوابة الطالب</span>
                <h4 class="fw-bold mb-1"><i class="bi bi-cloud-arrow-up-fill text-primary me-2"></i>تسليم حل التاسك</h4>
                @if (!string.IsNullOrEmpty(Model.AssignmentTitle))
                {
                    <p class="text-muted small mb-0">التاسك: <strong>@Model.AssignmentTitle</strong></p>
                }
            </div>
            <div class="card-body p-4">
                <form asp-action="Submit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="AssignmentId" />
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="SolutionFile" class="form-label fw-semibold"></label>
                        <input asp-for="SolutionFile" type="file" class="form-control" accept=".zip,.rar,.pdf" />
                        <span asp-validation-for="SolutionFile" class="text-danger small"></span>
                        <div class="form-text">يمكنك ضغط المشروع في ملف ZIP أو رفع ملف PDF (يحفظ في wwwroot/uploads/submissions)</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="StudentNotes" class="form-label fw-semibold"></label>
                        <textarea asp-for="StudentNotes" class="form-control" rows="3" placeholder="اكتب أي ملاحظات أو رابط GitHub إضافي للمحاضر..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Assignments" asp-action="Details" asp-route-id="@Model.AssignmentId" class="btn btn-light rounded-pill px-4">إلغاء</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-send-check me-1"></i> إرسال الحل للمحاضر
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
