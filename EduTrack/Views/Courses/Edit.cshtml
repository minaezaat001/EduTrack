@*
    ================================================================================
    [دليل الطالب - Courses/Edit.cshtml]
    - Model: CourseFormViewModel
    - Controller: CoursesController -> [Authorize(Roles = "Admin")]
    - في الـ GET: املأ CourseFormViewModel من الكورس الحالي وضع المسار القديم في ExistingThumbnailPath.
    - في الـ POST: إذا رفع المستخدم صورة جديدة في ThumbnailFile، احذف الصورة القديمة من السيرفر (إن وجدت) وارفع الجديدة.
    ================================================================================
*@
@model CourseFormViewModel
@{
    ViewData["Title"] = "تعديل الكورس";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>تعديل بيانات الكورس</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ExistingThumbnailPath" />
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="TotalHours" class="form-label fw-semibold"></label>
                            <input asp-for="TotalHours" type="number" class="form-control" />
                            <span asp-validation-for="TotalHours" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="InstructorId" class="form-label fw-semibold"></label>
                            <select asp-for="InstructorId" asp-items="ViewBag.Instructors" class="form-select"></select>
                            <span asp-validation-for="InstructorId" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ExistingThumbnailPath))
                    {
                        <div class="mb-3">
                            <label class="form-label d-block small text-muted">صورة الغلاف الحالية:</label>
                            <img src="~/images/courses/@Model.ExistingThumbnailPath" alt="Current Thumbnail" class="rounded-3 border" style="height: 100px;" />
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="ThumbnailFile" class="form-label fw-semibold">تغيير صورة الغلاف (اختياري)</label>
                        <input asp-for="ThumbnailFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">إلغاء</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-save me-1"></i> حفظ التعديلات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
