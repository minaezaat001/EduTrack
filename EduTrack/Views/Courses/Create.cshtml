@*
    ================================================================================
    [دليل الطالب - Courses/Create.cshtml]
    - Model: CourseFormViewModel
    - Controller: CoursesController -> [Authorize(Roles = "Admin")]
    - في الـ GET: أرسل قائمة المحاضرين في ViewBag.Instructors:
      ViewBag.Instructors = new SelectList(_context.Instructors.ToList(), "Id", "FullName");
    - في الـ POST: ارفع صورة الغلاف ThumbnailFile إلى wwwroot/images/courses واحفظ الكورس.
    ================================================================================
*@
@model CourseFormViewModel
@{
    ViewData["Title"] = "إضافة كورس جديد";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-journal-plus text-primary me-2"></i>إضافة كورس تدريبي جديد</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="مثال: دبلومة ASP.NET Core MVC المتكاملة" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="اكتب وصفاً مختصراً لمحتوى الكورس..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="TotalHours" class="form-label fw-semibold"></label>
                            <input asp-for="TotalHours" type="number" class="form-control" placeholder="مثال: 60" />
                            <span asp-validation-for="TotalHours" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="InstructorId" class="form-label fw-semibold"></label>
                            <select asp-for="InstructorId" asp-items="ViewBag.Instructors" class="form-select">
                                <option value="">-- اختر المحاضر المسؤول --</option>
                            </select>
                            <span asp-validation-for="InstructorId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ThumbnailFile" class="form-label fw-semibold"></label>
                        <input asp-for="ThumbnailFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">سيتم حفظ صورة الغلاف في المسار wwwroot/images/courses</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">إلغاء</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-check-lg me-1"></i> حفظ الكورس
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
