@*
    ================================================================================
    [دليل الطالب - Courses/Index.cshtml]
    - Model: IEnumerable<Course>
    - Controller: CoursesController -> [Authorize]
    - Action: Index() [GET]
    - الفلترة المطلوبة في الـ Controller حسب الرول:
      * إذا كان User.IsInRole("Admin") -> يعرض كل الكورسات
      * إذا كان User.IsInRole("Instructor") -> يعرض فقط الكورسات الخاصة بهذا المحاضر (عن طريق UserId)
      * إذا كان User.IsInRole("Student") -> يعرض الكورس المسجل فيه الطالب (أو كل الكورسات مع تمييز كورسه)
    - لا تنسَ: .Include(c => c.Instructor).Include(c => c.Assignments).Include(c => c.Students)
    ================================================================================
*@
@model IEnumerable<Course>
@{
    ViewData["Title"] = "الكورسات التدريبية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-journal-code text-primary me-2"></i>الكورسات التدريبية</h3>
        <p class="text-muted small mb-0">تصفح الكورسات المتاحة وتابع التاسكات الخاصة بكل كورس</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i> إضافة كورس جديد
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info border-0 shadow-sm rounded-4 p-4 text-center">
        <i class="bi bi-journal-x fs-2 d-block mb-2"></i>
        لا توجد كورسات متاحة للعرض حالياً.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden d-flex flex-column">
                    @if (!string.IsNullOrEmpty(course.ThumbnailPath))
                    {
                        <img src="~/images/courses/@course.ThumbnailPath" alt="@course.Title"
                             class="card-img-top object-fit-cover" style="height: 190px;" />
                    }
                    else
                    {
                        <div class="bg-dark text-white d-flex align-items-center justify-content-center" style="height: 190px;">
                            <i class="bi bi-code-square display-3 text-info"></i>
                        </div>
                    }

                    <div class="card-body p-4 d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3">
                                <i class="bi bi-clock me-1"></i> @course.TotalHours ساعة
                            </span>
                            <span class="text-muted small">
                                <i class="bi bi-list-task me-1"></i> @(course.Assignments?.Count ?? 0) تاسك
                            </span>
                        </div>

                        <h5 class="fw-bold mb-2">@course.Title</h5>
                        <p class="text-muted small flex-grow-1">@course.Description</p>

                        <div class="d-flex align-items-center gap-2 bg-light rounded-3 p-2 mb-3 small">
                            <i class="bi bi-person-video3 text-primary fs-5"></i>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">المحاضر:</span>
                                <strong>@(course.Instructor?.FullName ?? "غير محدد")</strong>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-auto">
                            <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-primary rounded-pill flex-grow-1">
                                <i class="bi bi-folder2-open me-1"></i> دخول الكورس والتاسكات
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-outline-secondary rounded-pill" title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
