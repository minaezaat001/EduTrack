@*
    ================================================================================
    [دليل الطالب - Students/Index.cshtml]
    - Model: IEnumerable<Student>
    - Controller: StudentsController -> [Authorize(Roles = "Admin")]
    - Action: Index() [GET]
    - استخدم:
      _context.Students
          .Include(s => s.Course)
          .Include(s => s.User)
          .Include(s => s.Submissions)
          .ToList();
    ================================================================================
*@
@model IEnumerable<Student>
@{
    ViewData["Title"] = "قائمة الطلاب المسجلين";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>قائمة الطلاب المسجلين</h3>
        <p class="text-muted small mb-0">متابعة الطلاب والكورسات الملتحقين بها وعدد التاسكات المسلمة</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>اسم الطالب</th>
                    <th>البريد الإلكتروني</th>
                    <th>رقم الهاتف</th>
                    <th>الجامعة</th>
                    <th>الكورس المسجل به</th>
                    <th>التسليمات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">لا يوجد طلاب مسجلون حتى الآن.</td>
                    </tr>
                }
                else
                {
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.Id</td>
                            <td class="fw-bold">@student.FullName</td>
                            <td>@(student.User?.Email ?? "-")</td>
                            <td>@student.PhoneNumber</td>
                            <td>@(student.University ?? "-")</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">
                                    @(student.Course?.Title ?? "غير محدد")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-secondary rounded-pill">@(student.Submissions?.Count ?? 0) تسليم</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
