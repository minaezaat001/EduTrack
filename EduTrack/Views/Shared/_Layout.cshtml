@*
    ================================================================================
    [دليل الطالب - _Layout.cshtml]
    - هذا الملف يمثل الهيكل الموحد للمنصة (Navbar + Footer).
    - يستخدم User.Identity.IsAuthenticated لمعرفة هل المستخدم مسجل دخول أم لا.
    - يستخدم User.IsInRole("Admin" / "Instructor" / "Student") لإظهار الروابط حسب الصلاحية.
    - يحتوي على زر سريع لتشغيل (Account/SetupSystem) لتهيئة الـ Roles وحساب الـ Admin أول مرة.
    ================================================================================
*@
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - منصة EduTrack التعليمية</title>
    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary rounded-3 p-2"><i class="bi bi-mortarboard-fill fs-5"></i></span>
                    <span>EduTrack <small class="text-info fw-normal fs-6">Core Academy</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> الرئيسية
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Courses" asp-action="Index">
                                    <i class="bi bi-journal-code me-1"></i> الكورسات
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Instructors" asp-action="Index">
                                        <i class="bi bi-person-badge me-1"></i> إدارة المحاضرين
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Students" asp-action="Index">
                                        <i class="bi bi-people me-1"></i> قائمة الطلاب
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-semibold" asp-controller="Submissions" asp-action="MySubmissions">
                                        <i class="bi bi-cloud-check me-1"></i> تسليماتي ودرجاتي
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                    <i class="bi bi-person-circle me-1"></i> مرحباً، @User.Identity.Name
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger ms-1">Admin</span>
                                    }
                                    else if (User.IsInRole("Instructor"))
                                    {
                                        <span class="badge bg-info text-dark ms-1">Instructor</span>
                                    }
                                    else if (User.IsInRole("Student"))
                                    {
                                        <span class="badge bg-success ms-1">Student</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        <i class="bi bi-box-arrow-left me-1"></i> تسجيل خروج
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-warning btn-sm rounded-pill px-3" asp-controller="Account" asp-action="SetupSystem" title="اضغط هنا أول مرة لإنشاء الـ Roles وحساب الأدمِن">
                                    <i class="bi bi-gear-wide-connected me-1"></i> تهيئة النظام (Setup)
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-Left me-1"></i> دخول
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> تسجيل طالب جديد
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container text-center text-muted small">
            جميع الحقوق محفوظة &copy; @DateTime.Now.Year - مشروع <strong>EduTrack</strong> التدريبي لطلاب <strong>Core Academy</strong> (م. مينا عزت)
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
