@*
    ================================================================================
    [دليل الطالب - Instructors/Create.cshtml]
    - Model: CreateInstructorViewModel
    - Controller: InstructorsController -> [Authorize(Roles = "Admin")]
    - ملاحظة مهمة: الفورم يحتوي على enctype="multipart/form-data" لرفع الصورة الشخصية!
    - خطوات الـ POST Action:
      1) ارفع ملف ProfileImage (إن وجد) إلى المسار wwwroot/images/instructors واحفظ اسم الملف الفريد.
      2) أنشئ كائن ApplicationUser بالإيميل والاسم، واحفظه بـ _userManager.CreateAsync(user, model.Password).
      3) أعطه صلاحية المحاضر: await _userManager.AddToRoleAsync(user, "Instructor").
      4) أنشئ كائن Instructor واربطه بـ UserId = user.Id و ImagePath = uniqueFileName واحفظه في الداتابيز.
    ================================================================================
*@
@model CreateInstructorViewModel
@{
    ViewData["Title"] = "إضافة محاضر جديد";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h4 class="fw-bold mb-0"><i class="bi bi-person-plus-fill text-primary me-2"></i>إضافة محاضر جديد وإنشاء حسابه</h4>
                <p class="text-muted small mb-0">سيتم إنشاء حساب دخول للمحاضر بصلاحية (Instructor) تلقائياً</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">1. البيانات الشخصية والتقنية</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="مثال: م. مينا عزت" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Specialization" class="form-label fw-semibold"></label>
                            <input asp-for="Specialization" class="form-control" placeholder="مثال: Senior .NET Backend Instructor" />
                            <span asp-validation-for="Specialization" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Bio" class="form-label fw-semibold"></label>
                            <textarea asp-for="Bio" class="form-control" rows="2" placeholder="نبذة مختصرة عن خبرات المحاضر..."></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="ProfileImage" class="form-label fw-semibold"></label>
                            <input asp-for="ProfileImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <div class="form-text">يفضل رفع صورة مربعة بصيغة JPG أو PNG (تحفظ في wwwroot/images/instructors)</div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">2. بيانات حساب الدخول (Identity Account)</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="instructor@edutrack.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="كلمة مرور المحاضر" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">إلغاء</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-check-lg me-1"></i> حفظ المحاضر وإنشاء الحساب
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
