@*
    ================================================================================
    [دليل الطالب - Instructors/Index.cshtml]
    - Model: IEnumerable<Instructor>
    - Controller: InstructorsController -> [Authorize(Roles = "Admin")]
    - Action: Index() [GET]
    - لا تنسَ استخدام .Include(i => i.Courses).Include(i => i.User) لعرض إيميل المحاضر وعدد كورساته!
    ================================================================================
*@
@model IEnumerable<Instructor>
@{
    ViewData["Title"] = "إدارة المحاضرين";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-badge text-primary me-2"></i>إدارة المحاضرين</h3>
        <p class="text-muted small mb-0">قائمة المحاضرين المسجلين في الأكاديمية وحساباتهم</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-person-plus-fill me-1"></i> إضافة محاضر جديد
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info rounded-4 border-0 shadow-sm p-4 text-center">
        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
        لا يوجد محاضرون حالياً. اضغط على "إضافة محاضر جديد" لإنشاء أول حساب محاضر.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 text-center">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="~/images/instructors/@item.ImagePath" alt="@item.FullName"
                                 class="rounded-circle object-fit-cover border border-3 border-primary mb-3"
                                 style="width: 96px; height: 96px;" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width: 96px; height: 96px;">
                                <i class="bi bi-person-video3 fs-1"></i>
                            </div>
                        }

                        <h5 class="fw-bold mb-1">@item.FullName</h5>
                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3 py-1 mb-2">@item.Specialization</span>

                        <p class="text-muted small mb-3">
                            @(string.IsNullOrEmpty(item.Bio) ? "محاضر معتمد في Core Academy" : item.Bio)
                        </p>

                        <div class="bg-light rounded-3 p-2 small text-muted mb-3">
                            <div><i class="bi bi-envelope me-1"></i> @(item.User?.Email ?? "بدون بريد")</div>
                            <div class="fw-semibold text-dark mt-1">
                                <i class="bi bi-journal-code text-primary me-1"></i> عدد الكورسات: @(item.Courses?.Count ?? 0)
                            </div>
                        </div>

                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill w-100">
                            <i class="bi bi-eye me-1"></i> عرض التفاصيل والكورسات
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
